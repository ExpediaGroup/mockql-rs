---
source: crates/mockql-core/src/graphql/abstract_typename_injector.rs
input_file: crates/mockql-core/src/graphql/snapshots/abstract_typename_injector/selected_operation.graphql
---
query Mocked {
  ...MockedFields
}

query Unmocked {
  ...UnmockedFields
}

fragment MockedFields on Query {
  node(id: "1") {
    id
    __typename
  }
}

fragment UnmockedFields on Query {
  search(query: "keyboard") {
    ... on Product {
      name
    }
  }
}
