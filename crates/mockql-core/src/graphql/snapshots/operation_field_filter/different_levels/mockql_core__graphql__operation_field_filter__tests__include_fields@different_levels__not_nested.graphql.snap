query ComplexQuery {
  topProducts(first: 10) @mock(hint: "popular products") {
    upc
    name
  }
  recommendedProducts {
    reviewsForAuthor(authorID: 14) @mock(hint: "reviews by author") {
      id
      body
    }
  }
  me {
    username @mock(hint: "unique username")
    reviews {
      body @mock(hint: "a rant review")
    }
  }
}
