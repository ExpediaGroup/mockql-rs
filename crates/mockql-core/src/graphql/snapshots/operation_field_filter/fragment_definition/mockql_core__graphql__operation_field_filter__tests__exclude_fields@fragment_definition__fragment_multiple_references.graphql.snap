input_file: crates/mockql-core/src/graphql/snapshots/operation_field_filter/fragment_definition/fragment_multiple_references.graphql
---
query GetProducts {
  topProducts {
    ...ProductFragment
  }
  recommendedProducts {
    ...ProductFragment
  }
}

fragment ProductFragment on Product {
  id
  price
}
