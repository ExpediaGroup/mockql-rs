---
source: crates/mockql-core/src/graphql/operation_field_filter/mod.rs
input_file: crates/mockql-core/src/graphql/snapshots/operation_field_filter/nested_fragment_spreads/operation.graphql
---
query GetUserReviews {
  me {
    ...UserReviews
  }
}

fragment UserReviews on User {
  reviews {
    body @mock(hint: "review body")
    ...ReviewProduct
  }
}

fragment ReviewProduct on Review {
  product {
    name @mock(hint: "product name")
  }
}
